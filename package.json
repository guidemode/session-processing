{
  "name": "@guidemode/session-processing",
  "version": "0.2.7",
  "description": "Shared session processing, metrics calculation, AI processing, and UI components for GuideMode",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/guidemode/session-processing.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": {
      "style": "./index.css",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./processors": {
      "types": "./dist/esm/processors/index.d.ts",
      "import": "./dist/esm/processors/index.js",
      "require": "./dist/cjs/processors/index.js"
    },
    "./ai-models": {
      "types": "./dist/esm/ai-models/index.d.ts",
      "import": "./dist/esm/ai-models/index.js",
      "require": "./dist/cjs/ai-models/index.js"
    },
    "./ui": {
      "style": "./index.css",
      "types": "./dist/esm/ui/index.d.ts",
      "import": "./dist/esm/ui/index.js",
      "require": "./dist/cjs/ui/index.js"
    },
    "./validation": {
      "types": "./dist/esm/validation/index.d.ts",
      "import": "./dist/esm/validation/index.js",
      "require": "./dist/cjs/validation/index.js"
    }
  },
  "files": [
    "dist",
    "index.css"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:cjs && pnpm run build:cjs-package",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:cjs-package": "echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "dev": "tsc --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src --diagnostic-level=error",
    "lint:all": "biome check src",
    "lint:fix": "biome check --write src"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@google/generative-ai": "^0.21.0",
    "@guidemode/types": "workspace:*",
    "canvas-confetti": "^1.9.4"
  },
  "peerDependencies": {
    "@heroicons/react": "^2.0.0",
    "@tanstack/react-virtual": "^3.0.0",
    "daisyui": ">=4.0.0",
    "dompurify": "^3.0.8",
    "marked": "^11.0.0",
    "prismjs": "^1.29.0",
    "react": "^18.3.1",
    "react-markdown": "^9.0.0",
    "react-syntax-highlighter": "^15.5.0",
    "recharts": "^2.0.0",
    "tailwindcss": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "@heroicons/react": {
      "optional": false
    },
    "tailwindcss": {
      "optional": true
    },
    "daisyui": {
      "optional": true
    },
    "dompurify": {
      "optional": true
    },
    "marked": {
      "optional": true
    },
    "prismjs": {
      "optional": true
    },
    "react-markdown": {
      "optional": true
    },
    "react-syntax-highlighter": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "@tanstack/react-virtual": {
      "optional": true
    }
  },
  "devDependencies": {
    "@heroicons/react": "^2.2.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dompurify": "^3.0.5",
    "@types/marked": "^6.0.0",
    "@types/prismjs": "^1.26.0",
    "@types/react": "^18.3.24",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitest/coverage-v8": "^3.2.4",
    "dompurify": "^3.0.8",
    "marked": "^11.0.0",
    "prismjs": "^1.29.0",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.6.1",
    "recharts": "^2.15.4",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "session-processing",
    "metrics",
    "ai",
    "typescript",
    "guidemode"
  ]
}
